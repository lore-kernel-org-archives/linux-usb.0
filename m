-		ret = -1;
-		goto close_fd;
-	}
-
-	printf("Authenticated, result (%02x), sig-size (%02x)\n",
-	       authenticate.result_code, authenticate.signature_size);
-
-close_fd:
-	close(fd);
-
-	return ret;
-}
